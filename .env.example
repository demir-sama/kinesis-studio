# ── Otari gateway (required for AI generation) ─────────────────────────────
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_API_KEY=            # otk_… from otari.ai (a service key if OTARI_PER_USER=1)

# ── Models: catalog ids or routing-policy names ────────────────────────────
KINESIS_MODEL_DIRECTOR=deepseek/deepseek-v4.1-flash
KINESIS_MODEL_ANIMATOR=z-ai/glm-5.3
KINESIS_MODEL_CRITIC=deepseek/deepseek-v4.1-flash

# ── Per-visitor budgets (needs a service key) ──────────────────────────────
OTARI_PER_USER=0
OTARI_END_USER_BUDGET=    # end-user budget id new visitors start on

# ── Optional Otari features ────────────────────────────────────────────────
KINESIS_GUARDRAILS=       # e.g. prompt-injection:block
KINESIS_RESEARCH=on       # otari_web_search for the director
KINESIS_CODE_EXECUTION=on # otari_code_execution + sandbox validation
KINESIS_PUBLIC_URL=       # public https URL, used for the MCP server Otari calls
KINESIS_MCP_URL=          # override, or "off"
